# -----------------------------------------------------------------------------
# VERDANT environment
#
# Copy to `.env.local` and fill in. Every value here is optional for local
# development — `npm run dev` works with no configuration at all.
# -----------------------------------------------------------------------------

# Secret used to hash session tokens.
#
# REQUIRED in production. Without it, sessions reset on every restart.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# SESSION_SECRET=

# Where the SQLite database lives. Defaults to ./data/verdent.db
# VERDENT_DB_PATH=

# Where uploaded tray photos are stored. Must be an absolute path.
# Defaults to ./data/uploads
# UPLOAD_DIR=

# Maximum upload size in megabytes (1–12, default 6).
# MAX_UPLOAD_MB=6